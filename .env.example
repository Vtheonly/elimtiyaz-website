# El-Imtiyaz Parent Portal — environment template
#
# Copy to .env.local and fill in the values from the canonical credential
# sheet: docs/operations/credentials.md in the hub repository
# (AgentGithubUplaod). The Supabase URL and anon key below are the REAL
# production values (both are public client-side identifiers — they are
# designed to ship inside the browser bundle and are protected by RLS,
# not by secrecy). Firebase web config is likewise public.
#
# NEVER put the service_role key or any server secret in this file —
# it is compiled into the client bundle.

# ── Supabase (shared backend — same project as desktop + Android) ──────────
# T-096 (2026-08-31): the URL and anon key below are the REAL production
# values, committed because they are public client identifiers (they ship in
# the browser bundle regardless). The portal ALSO falls back to these values
# at runtime via src/lib/public-config.ts — a fresh clone works without this
# file. Copy to .env.local ONLY to override (e.g. point at a different
# project for testing).
NEXT_PUBLIC_SUPABASE_URL=https://hkvkefubghbbotgnteir.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhrdmtlZnViZ2hiYm90Z250ZWlyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUwMDQ2ODQsImV4cCI6MjEwMDU4MDY4NH0.GDQiKjp4YBbCpsgoJXeSUqUT8Ag67He2fmngy6NNPmk

# ── Firebase web (FCM push notifications) ──────────────────────────────────
# Project: elimtiyaz-android (shared with the Android app). All values below
# are public web config. NOTE: the web APP_ID and VAPID key are left EMPTY on
# purpose — the known app id is the ANDROID app id (a different app), and no
# web VAPID key has been issued. Web push stays disabled until the owner
# supplies the real web values (isFcmConfigured stays false — truthful).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAzDjnuF7QMh3jWZAoJYiIxohfAD7Ba3_8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=elimtiyaz-android.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=elimtiyaz-android
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=elimtiyaz-android.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=259221439109
NEXT_PUBLIC_FIREBASE_APP_ID=
